# ==========================================
# Enterprise Customer Churn & CLV Engine
# Git Ignore Rules
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Node & Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.vite/
frontend/.vite/

# --- Environment & Secret Variables ---
.env
*.env
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# --- Logs & Performance Traces ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Uploaded Customer Data ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- Model Binaries & Generated Artifacts (Auto-bootstrapped on startup) ---
backend/saved_models/*.pkl
backend/saved_models/*.joblib
!backend/saved_models/.gitkeep

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
